{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": ".content-check",
    "rootDir": ".",
    "target": "ES2022"
  },
  "include": [
    "scripts/content-check.ts",
    "src/config/knowledge.ts",
    "src/config/product-media.ts",
    "src/config/product-routes.ts",
    "src/config/products.ts",
    "src/config/site.ts",
    "src/content/knowledge-content-validation.ts",
    "src/content/product-content-validation.ts",
    "src/instrumentation.ts"
  ]
}
